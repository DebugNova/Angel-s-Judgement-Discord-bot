# ───────────── Discord ─────────────
# Bot token from https://discord.com/developers/applications → your app → Bot → Reset Token
DISCORD_TOKEN=
# Application ID (optional — derived from the token when empty)
DISCORD_CLIENT_ID=
# Optional. When set, slash commands are registered ONLY in this server (handy for a test server).
# When empty, commands are registered in every server the bot is in.
DISCORD_GUILD_ID=
# Comma-separated Discord user IDs with Owner-level bot access (server owners always have it)
BOT_OWNER_IDS=

# ───────────── Database ─────────────
# true  = the bot starts its own local PostgreSQL automatically (free, no install needed)
# false = connect to DATABASE_URL (Docker, VPS, Supabase, any PostgreSQL)
EMBEDDED_DB=true
# Where the embedded database stores its files (default: %LOCALAPPDATA%/SatanBot/postgres or ~/.satan-bot/postgres)
EMBEDDED_DB_DIR=
EMBEDDED_DB_PORT=54321
# Required when EMBEDDED_DB=false
DATABASE_URL=

# ───────────── Runtime ─────────────
# development | staging | production
NODE_ENV=development
# debug | info | warn | error
LOG_LEVEL=info
